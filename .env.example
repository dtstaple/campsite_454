# CampSite local environment. `make setup` copies this to .env (repo root) if .env is missing.
# Never commit .env -- only this example. Every variable backend/config/settings.py reads is
# listed here. Values below are placeholders that work for local development as-is.

# --- PostGIS container (read by docker-compose.yml) -----------------------------------------
POSTGRES_DB=campsite
POSTGRES_USER=campsite
# Local-only password; the container is published on localhost. Change it if you like, but
# change it in DATABASE_URL below too -- they must match.
POSTGRES_PASSWORD=change-me-locally
# Host port for the database. Change it (e.g. 5434) if something else already uses 5432,
# such as a Homebrew PostgreSQL, and use the same port in DATABASE_URL.
POSTGRES_PORT=5432
# Container name, so two checkouts (or a test) can run side by side. Default: campsite_db.
DB_CONTAINER_NAME=campsite_db
# Compose project name; also prefixes the data volume. Default: the folder name.
# COMPOSE_PROJECT_NAME=campsite

# --- Django -> PostGIS (required) -----------------------------------------------------------
# Same credentials and port as above. Host is localhost because manage.py runs on your
# machine and Compose publishes the port. A hosted PostGIS works too: paste its URL and
# append ?sslmode=require. Percent-encode special characters in the password (@ -> %40).
DATABASE_URL=postgis://campsite:change-me-locally@localhost:5432/campsite

# --- Django ---------------------------------------------------------------------------------
# Any long random string for local use. Default if unset: an insecure dev-only key.
SECRET_KEY=change-me-locally
# "True" or "False". Default: True.
DEBUG=True
# Comma-separated. Default: localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins allowed to call the API: the Vite dev server on port 5173, under
# both names a browser may use. Required -- settings.py's own default (port 3000) is stale.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Development only, and only while DEBUG is True: one extra origin to trust for CORS and
# CSRF. `make dev-phone` sets it to https://<this machine's LAN address>:5173 for testing on a
# phone (docs/setup.md). Leave it unset otherwise.
# DEV_LAN_ORIGIN=

# --- Source API keys (optional) -------------------------------------------------------------
# Recreation.gov / RIDB. OPTIONAL: only the `ridb` ingest uses it, and RIDB is federal-only,
# so the Adirondacks (state land) have no RIDB campsites anyway. Free key: sign up at
# https://ridb.recreation.gov/ and copy the key from your profile page. Leave empty to skip.
RIDB_API_KEY=

# --- GeoDjango library paths ----------------------------------------------------------------
# Django 5.1 finds GDAL by probing names for versions 3.0-3.8 only. A newer GDAL (Homebrew
# ships 3.9+) is not found and import fails with "Could not find the GDAL library".
#   Unset (commented out) -> Django searches the system default paths. Right for Linux/WSL
#                            with apt's GDAL, and for CI.
#   macOS, Apple Silicon (Homebrew in /opt/homebrew) -- `make setup` fills these in for you:
#     GDAL_LIBRARY_PATH=/opt/homebrew/opt/gdal/lib/libgdal.dylib
#     GEOS_LIBRARY_PATH=/opt/homebrew/opt/geos/lib/libgeos_c.dylib
#   macOS, Intel (Homebrew in /usr/local):
#     GDAL_LIBRARY_PATH=/usr/local/opt/gdal/lib/libgdal.dylib
#     GEOS_LIBRARY_PATH=/usr/local/opt/geos/lib/libgeos_c.dylib
#   Linux/WSL, only if the default search fails (find yours with `ldconfig -p | grep gdal`):
#     GDAL_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/libgdal.so
#     GEOS_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/libgeos_c.so
# GDAL_LIBRARY_PATH=
# GEOS_LIBRARY_PATH=

# --- Frontend (optional; read by Vite from frontend/.env, not this file) --------------------
# VITE_API_BASE_URL=http://127.0.0.1:8000
# VITE_MAP_STYLE_URL=https://tiles.stadiamaps.com/styles/alidade_smooth_dark.json
