# Copy this file to .env at the repo root and fill in local values.
# Never commit .env — only this example file.

# --- PostGIS container (read by docker-compose.yml) ---
POSTGRES_DB=campsite
POSTGRES_USER=campsite
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

# --- Django -> PostGIS ---
# Credentials must match the POSTGRES_* values above. Host is localhost because
# manage.py runs on your machine and Compose publishes the port; use `db` as the
# host only from inside the Compose network. To use a hosted PostGIS database instead,
# replace this line with the provider's URL and append ?sslmode=require -- no code changes.
# Percent-encode special characters in the password (@ becomes %40).
DATABASE_URL=postgis://campsite:change-me-locally@localhost:5432/campsite

# --- Django ---
SECRET_KEY=change-me-locally
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Source API keys ---
# Recreation.gov / RIDB. Free to register at https://ridb.recreation.gov/profile.
# Required only by the `ridb` adapter; the other three sources need no credentials.
RIDB_API_KEY=your-ridb-api-key-here

# --- GeoDjango library paths ---
# Django 5.1 only probes for GDAL 3.0-3.8 by name, so a newer Homebrew GDAL (3.9+)
# is not found automatically and raises "Could not find the GDAL library".
# Required on macOS/Homebrew; harmless to leave set. Linux users can usually omit.
GDAL_LIBRARY_PATH=/opt/homebrew/opt/gdal/lib/libgdal.dylib
GEOS_LIBRARY_PATH=/opt/homebrew/opt/geos/lib/libgeos_c.dylib
