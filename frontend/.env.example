VITE_API_BASE_URL=http://127.0.0.1:8000

# Basemap style. Stadia Maps "Alidade Smooth Dark" allows keyless access from
# allowlisted domains including localhost, so this works in development as-is.
# For a deployed domain, register a free key at https://client.stadiamaps.com
# and append ?api_key=YOUR_KEY to this URL -- no code change needed.
VITE_MAP_STYLE_URL=https://tiles.stadiamaps.com/styles/alidade_smooth_dark.json

# Fallback if Stadia's terms change. Raster, not vector, so labels are baked in
# and it cannot be restyled -- but it is dark and needs no key:
# VITE_MAP_STYLE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer
